<UserControl x:Class="AIAssistant.Features.VoiceAssistant.VoiceAssistantControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5">
            <ToggleButton x:Name="VoiceModeMainToggle" Content="Voice Mode" Checked="VoiceModeMainToggle_Checked" Unchecked="VoiceModeMainToggle_Unchecked" Margin="0,0,10,0"/>
            <ui:Button x:Name="VoiceCommandBtn" Content="🎤 Manual Voice" Click="VoiceCommand_Click" Appearance="Primary" Margin="0,0,10,0"/>
            <TextBlock Text="Language:" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="Gray"/>
            <ComboBox x:Name="LanguageSelector" Width="80" SelectedIndex="0">
                <ComboBoxItem Content="en-US" ToolTip="English"/>
                <ComboBoxItem Content="hi-IN" ToolTip="Hindi"/>
                <ComboBoxItem Content="te-IN" ToolTip="Telugu"/>
                <ComboBoxItem Content="ta-IN" ToolTip="Tamil"/>
                <ComboBoxItem Content="es-ES" ToolTip="Spanish"/>
            </ComboBox>
        </StackPanel>

        <Border Grid.Row="1" Margin="5" Padding="10" Background="#1E1E1E" CornerRadius="4" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Voice &amp; Audio Settings" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="White"/>
                
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Microphone:" VerticalAlignment="Center" Grid.Column="0" Foreground="White"/>
                    <ComboBox x:Name="MicSelector" Grid.Column="1" HorizontalAlignment="Stretch" Background="#252526" Foreground="White"/>
                </Grid>
                
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Output Voice (TTS):" VerticalAlignment="Center" Grid.Column="0" Foreground="White"/>
                    <ComboBox x:Name="VoiceSelector" Grid.Column="1" HorizontalAlignment="Stretch" Background="#252526" Foreground="White"/>
                </Grid>

                <CheckBox x:Name="EnableTTSCheckbox" Content="Enable AI Voice Output" IsChecked="True" Margin="0,0,0,5" Foreground="White"/>

                <TextBlock Text="TTS Engine:" Margin="0,10,0,2" FontWeight="SemiBold" Foreground="White"/>
                <ComboBox x:Name="TTSEngineSelector" Margin="0,0,0,10" Background="#252526" Foreground="White">
                    <ComboBoxItem Content="Windows (Offline)" Tag="Windows" />
                    <ComboBoxItem Content="Google (Online - High Quality)" Tag="Google" IsSelected="True" />
                </ComboBox>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
