<UserControl x:Class="AIAssistant.Features.WorkspaceAgent.WorkspaceAgentControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="50" d:DesignWidth="600">
    <StackPanel Orientation="Horizontal" Margin="5">
        <TextBlock x:Name="WorkspaceText" Text="No workspace..." VerticalAlignment="Center" Margin="0,0,10,0" Width="150" TextTrimming="CharacterEllipsis"/>
        <TextBlock Text="Canvas:" VerticalAlignment="Center" Margin="0,0,5,0"/>
        <ComboBox x:Name="CanvasSelector" Width="120" Margin="0,0,10,0" SelectedIndex="0" SelectionChanged="CanvasSelector_SelectionChanged">
            <ComboBoxItem Content="Code Project"/>
            <ComboBoxItem Content="Document"/>
            <ComboBoxItem Content="Presentation"/>
            <ComboBoxItem Content="Spreadsheet"/>
        </ComboBox>
        <TextBlock Text="Format:" VerticalAlignment="Center" Margin="0,0,5,0"/>
        <ComboBox x:Name="FormatSelector" Width="90" SelectedIndex="0">
            <ComboBoxItem Content="Any"/>
        </ComboBox>
    </StackPanel>
</UserControl>
